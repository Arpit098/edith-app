#!/bin/bash
# Send a Telegram message to every allowlisted user: edith-notify "text"
D="${TELEGRAM_STATE_DIR:-$HOME/.claude/channels/telegram}"
T=$(sed -n 's/^TELEGRAM_BOT_TOKEN=//p' "$D/.env")
for id in $(python3 -c 'import json,sys;print(" ".join(json.load(open(sys.argv[1]))["allowFrom"]))' "$D/access.json"); do
  curl -s -m 15 "https://api.telegram.org/bot$T/sendMessage" -d chat_id="$id" --data-urlencode "text=$1" >/dev/null
done
