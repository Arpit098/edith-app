{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/home/ubuntu"
    ],
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_telegram_telegram"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(sudo *)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm --recursive --force:*)",
      "Bash(rm --force --recursive:*)"
    ]
  },
  "outputStyle": "EDITH",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/edith/bridge/hooks/edith_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/edith/bridge/hooks/edith_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/edith/bridge/hooks/edith_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $HOME/edith/bridge/hooks/edith_hook.py",
            "timeout": 660
          }
        ]
      }
    ]
  }
}