#!/usr/bin/env python3
"""Start EDITH's server from this checkout (edith-bridge.service runs it with the system python3):

    /usr/bin/python3 -I ~/edith-app-live/deploy/bin/edith-bridge --config ~/.config/edith/config.toml

Stdlib only. `-I` ignores PYTHONPATH and the current folder, so the server folder is added here.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))), "server"))

from edith.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
