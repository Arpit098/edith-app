# whisper.cpp speech-to-text for EDITH (docs/PHASE1_PLAN.md, step 9). Built by deploy/whisper/build.sh.
# Listens on 127.0.0.1 only: the App API (edith-bridge) is its one client. Never bind it elsewhere.
# The model is picked from deploy/whisper/bench.sh results; change WHISPER_MODEL to switch.
[Unit]
Description=E.D.I.T.H - whisper.cpp speech-to-text (localhost only)
After=network.target

[Service]
Type=simple
Environment=WHISPER_MODEL=%h/.local/share/whisper/ggml-small-q5_1.bin
# 2 threads = edith's 2 OCPU. Nice keeps the Telegram bridge and tmux Claude responsive during a transcription.
ExecStart=%h/opt/whisper.cpp/bin/whisper-server --host 127.0.0.1 --port 8178 --model ${WHISPER_MODEL} --threads 2 --language auto
Nice=5
MemoryMax=2G
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
