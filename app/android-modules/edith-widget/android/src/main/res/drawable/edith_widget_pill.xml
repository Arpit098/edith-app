<?xml version="1.0" encoding="utf-8"?>
<!--
  The EDITH bar's glass, approximated (a widget can't blur what's behind it): a faint outer edge,
  then a translucent pane, lighter at the top, with a thin light rim. Colours flip with dark mode
  (values / values-night).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="200dp" />
      <solid android:color="@color/edith_widget_rim_outer" />
    </shape>
  </item>
  <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
    <shape android:shape="rectangle">
      <corners android:radius="200dp" />
      <gradient android:angle="270" android:startColor="@color/edith_widget_glass_top" android:endColor="@color/edith_widget_glass_bottom" />
      <stroke android:width="1dp" android:color="@color/edith_widget_rim" />
    </shape>
  </item>
</layer-list>
