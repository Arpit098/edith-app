<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- EDITH's live status (Live Alerts): a notification, so Android 13+ asks once. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 16 Live Updates: lets the ongoing status be promoted to the status-bar chip
       (OxygenOS shows these in the Live Alerts pill). A normal permission, granted at install. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
</manifest>
