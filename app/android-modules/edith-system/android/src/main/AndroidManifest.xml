<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- EDITH's live status and notifications: Android 13+ asks once. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Android 16 Live Updates: lets the ongoing status be promoted to the status-bar chip
       (OxygenOS shows these in the Live Alerts pill). A normal permission, granted at install. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <!-- EdithSessionService, below. Normal permissions, granted at install. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- PushService resumes after a reboot, if Settings → Push is on. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!--
      Why a foreground service, and why "specialUse": while EDITH (Claude Code on Arpit's server)
      runs a task he started from this app, or waits for his approval, the app keeps its live
      connection to that server open so the task's progress, the approval prompt and the reply reach
      the phone (Live Alerts status and notifications) with the app in the background. No other
      foreground service type fits a user-started remote agent session: it isn't dataSync (nothing is
      transferred or synced), mediaPlayback, location or any of the others. It runs only while a turn
      is in progress or an approval is waiting, and stops the moment that's over; the user sees it as
      the live status notification the whole time.
    -->
    <service
      android:name="com.arpit.edith.system.EdithSessionService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Keeps the connection to the user's own remote assistant session open while a task the user started is running or waits for the user's approval; stops when it ends." />
    </service>
    <!--
      PushService, also "specialUse": with the app closed, it holds one connection to the user's own
      ntfy server on his private network (Tailscale) and shows the notifications it sends: replies,
      approvals, reminders. There is no push service it could use instead (no Google services or
      FCM: the server is self-hosted and private). Runs only while the user has turned on Settings →
      Push; its notification says so.
    -->
    <service
      android:name="com.arpit.edith.system.PushService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Holds the connection to the user's own self-hosted push server (ntfy over a private network) to show notifications from his assistant; on only while the user turns it on." />
    </service>
    <receiver android:name="com.arpit.edith.system.PushBootReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- Allow / Deny on a notification: sends the answer without opening the app. -->
    <receiver android:name="com.arpit.edith.system.NotificationActionReceiver" android:exported="false" />
  </application>
</manifest>
